<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Features>$(Features);runtime-async=on</Features>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A dependency-injection registration bundle for selected Cloudflare OpenAPI utilities.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Cloudflare.OpenApi.Suite</AssemblyName>
        <PackageId>Soenneker.Cloudflare.OpenApi.Suite</PackageId>
        <PackageTags>cloudflare openapi suite utilities util cloudflareopenapisuite csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2025-2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.cloudflare.openapi.suite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.cloudflare.openapi.suite</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <PackageReleaseNotes Condition="'$(PACKAGE_RELEASE_NOTES)' != ''">
            $(PACKAGE_RELEASE_NOTES)
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Cloudflare.Caching" Version="11.0.549" />
        <PackageReference Include="Soenneker.Cloudflare.DnsSettings" Version="11.0.550" />
        <PackageReference Include="Soenneker.Cloudflare.EmailRouting" Version="11.0.549" />
        <PackageReference Include="Soenneker.Cloudflare.Pages" Version="11.0.949" />
        <PackageReference Include="Soenneker.Cloudflare.R2" Version="11.0.111" />
        <PackageReference Include="Soenneker.Cloudflare.Registrar" Version="11.0.130" />
        <PackageReference Include="Soenneker.Cloudflare.ScrapeShield" Version="11.0.552" />
        <PackageReference Include="Soenneker.Cloudflare.Security" Version="11.0.533" />
        <PackageReference Include="Soenneker.Cloudflare.Speed" Version="11.0.551" />
        <PackageReference Include="Soenneker.Cloudflare.Ssl" Version="11.0.549" />
        <PackageReference Include="Soenneker.Cloudflare.WebAnalytics" Version="11.0.553" />
        <PackageReference Include="Soenneker.Cloudflare.Workers" Version="11.0.589" />
        <PackageReference Include="Soenneker.Cloudflare.Workers.Ai" Version="11.0.90" />
        <PackageReference Include="Soenneker.Cloudflare.Workers.Kv" Version="11.0.189" />
    </ItemGroup>
</Project>
